; ==========================================================
;  nStudio - INCLUDE-chain test        (open, then Ctrl+B)
; ==========================================================
;  This file is CORRECT.  The error is inside the file it
;  includes, examples/inchelper.asm.tns - both must sit in
;  the SAME folder on the calculator, since nasm resolves an
;  INCLUDE relative to the including file.
;
;  Assembling with Ctrl+B should:
;    1. run nasm, which lists the error in its own window;
;    2. after you close it, LEAVE THE CURSOR WHERE IT IS -
;       the error is not in this buffer, so there is nothing
;       to jump to - and report it in the status bar as:
;         Error 1/1 in inchelper.asm.tns:8
;           (from inctest.asm.tns:31): ... is unknown
;       Before this feature such an error was silently
;       skipped and Ctrl+B appeared to do nothing.
;
;  Press Ctrl+D for the details popup:
;    - title    : "Error  syntax"
;    - location : inchelper.asm.tns:8:2
;    - Included from:  inctest.asm.tns:31
;  There is no Related section here; Esc closes the popup.
;
;  To fix: open inchelper.asm.tns, correct line 8, and
;  assemble this file again.
; ==========================================================

main
 mov r0, #0
 INCLUDE inchelper.asm.tns
 mov r1, #1
 bx lr
